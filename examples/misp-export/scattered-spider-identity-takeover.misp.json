      {
        "uuid": "9490d43a-3aeb-5540-97e2-51e7d7918cf0",
        "name": "threat-hunt-hypothesis",
        "meta-category": "threat-hunting",
        "description": "",
        "template_uuid": "4136cd18-3edd-49fb-90ba-24cbacacc662",
