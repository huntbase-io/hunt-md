            "to_ids": false,
            "disable_correlation": true
          },
          {
            "uuid": "84bf4772-c966-5c55-8306-d1d0f64ac628",
            "object_relation": "query",
            "type": "text",
            "category": "Other",
            "value": "// Broad sweep of IR-topic mailbox/search activity; the agent correlates the\n// hits against the flagged identities in `assess-takeover`.\nOfficeActivity\n| where TimeGenerated > ago({{days}})\n| where Operation in (\"SearchQueryPerformed\", \"MessagesRead\", \"MailItemsAccessed\")\n| where OfficeObjectId has_any (\"incident\", \"compromise\", \"breach\",\n                                \"scattered\", \"containment\", \"soc\")\n| project TimeGenerated, UserId, Operation, OfficeObjectId",
