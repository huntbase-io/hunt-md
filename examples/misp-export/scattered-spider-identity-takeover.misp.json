      {
        "uuid": "75c22438-f750-5a21-82a3-905520b25af4",
        "name": "threat-hunt-query",
        "meta-category": "threat-hunting",
        "description": "",
        "template_uuid": "0fc943ec-c8fd-4311-b748-249bdef0f7d8",
        "template_version": "1",
        "comment": "hunt.md step `pivot-persistence/query-ir-surveillance`",
        "Attribute": [
          {
            "uuid": "3af19f5a-3a42-5ff7-85fc-83d5d09d36b0",
            "object_relation": "hypothesis-id",
            "type": "text",
            "category": "Other",
